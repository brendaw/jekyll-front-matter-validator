# Paste this into your site's _config.yml (don't replace the entire file).

front_matter_schema:
  # If false, only logs a warning but lets the build continue.
  fail_build_on_error: true

  # Rules applied to ANY file that doesn't match a
  # "collections" entry below.
  defaults:
    required: [title]
    types:
      title: string

  collections:
    posts:
      path: _posts
      required: [title, date, layout, slug, cover_image]
      types:
        title: string
        date: date
        tags: array
        published: boolean
        slug: slug          # validates lowercase, no accents/spaces
      enum:
        layout: [post, article]

      # For each field listed here, checks whether a matching asset file
      # exists for the value provided in front matter.
      assets:
        # front matter: cover_image: "cute-cats"
        # looks for assets/images/cute-cats.{jpg,jpeg,png,webp}
        cover_image:
          dir: assets/images
          extensions: [jpg, jpeg, png, webp]

        # front matter: slug: "My Cool Post"
        # normalizes to "my-cool-post" before looking for
        # assets/posts/my-cool-post/cover.*
        slug:
          pattern: "assets/posts/{value}/cover.*"
          slugify: true

    pages:
      path: _pages
      required: [title, layout, permalink]
      types:
        title: string
        permalink: string
      enum:
        layout: [page, landing]
