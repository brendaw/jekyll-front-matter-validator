#!/usr/bin/env ruby
# frozen_string_literal: true

#
# Usage:
#   fmv-validate                # validates all files in the project
#   fmv-validate --staged       # validates only git-staged files
#   fmv-validate path1 path2    # validates specific file(s)
#
require "jekyll-front-matter-validator"

def project_root
  root = `git rev-parse --show-toplevel 2>/dev/null`.strip
  root.empty? ? Dir.pwd : root
end

def staged_files
  `git diff --cached --name-only --diff-filter=ACM`.split("\n")
end

def all_content_files(root)
  Dir.glob(File.join(root, "**", "*.{md,markdown,html}")).reject do |f|
    f.include?("/_site/") || f.include?("/vendor/") || f.include?("/node_modules/")
  end
end

root = project_root
mode = ARGV.include?("--staged") ? :staged : :all
explicit_files = ARGV.reject { |a| a.start_with?("--") }

files =
  if explicit_files.any?
    explicit_files.map { |f| File.expand_path(f) }
  elsif mode == :staged
    staged_files.grep(/\.(md|markdown|html)\z/).map { |f| File.join(root, f) }
  else
    all_content_files(root)
  end

schema = Jekyll::FrontMatterValidator.load_schema(File.join(root, "_config.yml"))

if schema.empty?
  warn "No 'front_matter_schema' found in _config.yml — nothing to validate."
  exit 0
end

all_issues = []

files.each do |path|
  next unless File.exist?(path)

  rel_path = path.sub("#{root}/", "")

  fm, yaml_error = Jekyll::FrontMatterValidator.read_front_matter(path, staged: mode == :staged)

  if yaml_error
    all_issues << Jekyll::FrontMatterValidator::Issue.new(rel_path, "(yaml)", "Invalid YAML: #{yaml_error}", :error)
    next
  end
  next if fm.nil? # file without front matter, skip

  rules = Jekyll::FrontMatterValidator.rules_for(rel_path, schema)
  next unless Jekyll::FrontMatterValidator.has_rules?(rules)

  all_issues.concat(Jekyll::FrontMatterValidator.validate_all(fm, rules, file: rel_path, project_root: root))
end

RED = "\e[31m"
GREEN = "\e[32m"
RESET = "\e[0m"

if all_issues.empty?
  puts "#{GREEN}\u2714 Front matter valid in #{files.size} file(s).#{RESET}"
  exit 0
else
  puts "#{RED}\u2718 #{all_issues.size} front matter issue(s) found:#{RESET}\n\n"
  all_issues.each { |i| puts "  #{RED}#{i}#{RESET}" }
  puts
  exit 1
end
